# Copy this file to .env and fill in your actual values
# DO NOT commit .env to Git!

# Neo4j Aura (Free Tier: https://neo4j.com/cloud/aura/)
NEO4J_URI=bolt+s://your-instance.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Qdrant Cloud (Free Tier: https://cloud.qdrant.io/)
QDRANT_URL=https://your-instance.qdrant.io
QDRANT_API_KEY=your-qdrant-api-key
QDRANT_COLLECTION=finrag

# Google Gemini (Free quota available: https://ai.google.dev/)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash

# Upstash Vector (Free Tier: https://upstash.com/)
UPSTASH_VECTOR_REST_URL=https://your-instance.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your-upstash-token

# LangSmith (Optional - for observability)
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=finrag
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
